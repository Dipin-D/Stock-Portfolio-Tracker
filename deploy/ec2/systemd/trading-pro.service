[Unit]
Description=Trading Pro Gunicorn service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=tradingpro
Group=www-data
WorkingDirectory=/srv/trading-pro/app
EnvironmentFile=/etc/trading-pro/trading-pro.env
RuntimeDirectory=trading-pro
RuntimeDirectoryMode=0755
ExecStart=/bin/bash -lc '/srv/trading-pro/venv/bin/gunicorn --workers "${GUNICORN_WORKERS:-3}" --timeout "${GUNICORN_TIMEOUT:-180}" --graceful-timeout "${GUNICORN_GRACEFUL_TIMEOUT:-60}" --keep-alive "${GUNICORN_KEEP_ALIVE:-5}" --bind unix:/run/trading-pro/gunicorn.sock --access-logfile - --error-logfile - tradingmachine.wsgi:application'
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
UMask=0027

[Install]
WantedBy=multi-user.target
